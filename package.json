{
  "name": "@jb9k62/good2go",
  "version": "0.7.0",
  "description": "Node tooling for OKF (Open Knowledge Format) bundles and agent memory: validator, graph viewer, Mermaid gates, ranked search, and the edukai memory bundle, plus skills for Claude Code and pi.",
  "license": "MIT",
  "type": "module",
  "author": "jb9k62",
  "homepage": "https://github.com/jb9k62/okf-bootstrap#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jb9k62/okf-bootstrap.git"
  },
  "bugs": {
    "url": "https://github.com/jb9k62/okf-bootstrap/issues"
  },
  "keywords": [
    "pi-package",
    "claude-code",
    "agent-skill",
    "okf",
    "open-knowledge-format",
    "documentation",
    "good2go",
    "agent-memory",
    "mcp-free",
    "cli"
  ],
  "bin": {
    "good2go": "dist/good2go.mjs"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/templates/**/node_modules",
    "!dist/templates/**/dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "workspaces": [
    "skills/okf-bootstrap/assets/templates/okf-widgets"
  ],
  "pi": {
    "skills": [
      "./skills"
    ],
    "extensions": [
      "./extensions"
    ]
  },
  "scripts": {
    "build": "node scripts/build.mts",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck -w okf-widgets",
    "test": "node --test test/*.test.mts && npm test -w okf-widgets",
    "test:render": "node --test test/render.e2e.mts",
    "test:views": "node --test test/views.e2e.mts",
    "check": "npm run typecheck && npm test && npm run build && npm run test:views && npm run okf:validate && npm run edukai:validate",
    "okf:validate": "node --import ./skills/okf-bootstrap/assets/okf-start.mjs skills/okf-bootstrap/assets/okf-view.mts design --validate --strict",
    "okf:fix": "node --import ./skills/okf-bootstrap/assets/okf-start.mjs skills/okf-bootstrap/assets/okf-view.mts design --validate --fix",
    "okf:view": "npm run build -w okf-widgets && node --import ./skills/okf-bootstrap/assets/okf-start.mjs skills/okf-bootstrap/assets/okf-view.mts design --widgets skills/okf-bootstrap/assets/templates/okf-widgets/dist/okf-widgets.js",
    "okf:mermaid": "node --import ./skills/okf-bootstrap/assets/okf-start.mjs skills/okf-bootstrap/assets/okf-mermaid.mts design",
    "okf:mermaid:render": "npm run build -w okf-widgets && node --import ./skills/okf-bootstrap/assets/okf-start.mjs skills/okf-bootstrap/assets/okf-view.mts design --check-render --widgets skills/okf-bootstrap/assets/templates/okf-widgets/dist/okf-widgets.js",
    "okf:search": "node --import ./skills/okf-bootstrap/assets/okf-start.mjs skills/okf-bootstrap/assets/okf-search.mts",
    "okf:recheck": "node --import ./skills/okf-bootstrap/assets/okf-start.mjs skills/okf-bootstrap/assets/okf-edukai.mts recheck --bundle design",
    "edukai:validate": "node --import ./skills/okf-bootstrap/assets/okf-start.mjs skills/okf-bootstrap/assets/okf-view.mts edukai --validate --strict && node --import ./skills/okf-bootstrap/assets/okf-start.mjs skills/okf-bootstrap/assets/okf-edukai.mts index --check",
    "edukai:index": "node --import ./skills/okf-bootstrap/assets/okf-start.mjs skills/okf-bootstrap/assets/okf-edukai.mts index",
    "edukai:recheck": "node --import ./skills/okf-bootstrap/assets/okf-start.mjs skills/okf-bootstrap/assets/okf-edukai.mts recheck",
    "edukai:brief": "node --import ./skills/okf-bootstrap/assets/okf-start.mjs skills/okf-bootstrap/assets/okf-edukai.mts index && node --import ./skills/okf-bootstrap/assets/okf-start.mjs skills/okf-bootstrap/assets/okf-edukai-hook.mts brief",
    "edukai:search": "node --import ./skills/okf-bootstrap/assets/okf-start.mjs skills/okf-bootstrap/assets/okf-search.mts --bundle edukai",
    "edukai:view": "node --import ./skills/okf-bootstrap/assets/okf-start.mjs skills/okf-bootstrap/assets/okf-view.mts edukai",
    "demo": "npm run build -w okf-widgets && node skills/okf-bootstrap/assets/okf-view.mts examples/demo/okf --widgets skills/okf-bootstrap/assets/templates/okf-widgets/dist/okf-widgets.js",
    "demo:edukai": "npm run demo:edukai:brief && npm run demo:edukai:recheck",
    "demo:edukai:brief": "node skills/okf-bootstrap/assets/okf-edukai.mts index --bundle examples/demo/edukai --now 2026-10-15T00:00:00Z && node skills/okf-bootstrap/assets/okf-edukai-hook.mts brief --bundle examples/demo/edukai --now 2026-10-15T00:00:00Z",
    "demo:edukai:recheck": "node skills/okf-bootstrap/assets/okf-edukai.mts recheck --bundle examples/demo/edukai --now 2026-10-15T00:00:00Z",
    "demo:edukai:search": "node skills/okf-bootstrap/assets/okf-search.mts --bundle examples/demo/edukai --now 2026-10-15T00:00:00Z",
    "demo:edukai:view": "node skills/okf-bootstrap/assets/okf-view.mts examples/demo/edukai",
    "install-skill": "node scripts/install-skill.mts",
    "spec": "node scripts/okf-spec.mts",
    "screenshots": "node scripts/screenshots.mts"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^12.0.0",
    "@types/node": "^26.6.4",
    "cytoscape": "3.34.3",
    "marked": "18.0.14",
    "mermaid": "12.1.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2"
  }
}
