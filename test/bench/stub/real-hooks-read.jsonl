{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ERU3bAGEFoVLrJDXvfcsvD","type":"tool_result","content":"1\t// How the poller waits between retries of a failed carrier poll.\n2\t// The settings match okf/parcel-tracker/retry-policy.md and ADR-0003.\n3\t\n4\texport const RETRIES = 5;\n5\texport const BASE_MS = 500;\n6\texport const CAP_MS = 2_000;\n7\t\n8\t/**\n9\t * Full jitter: a random wait between zero and the capped exponential delay, so pollers that\n10\t * failed together do not retry together. `attempt` counts from 1.\n11\t */\n12\texport function retryDelayMs(attempt: number, random: () => number = Math.random): number {\n13\t  const backoff = Math.min(CAP_MS, BASE_MS * 2 ** (attempt - 1));\n14\t  return Math.floor(random() * backoff);\n15\t}\n16\t"}]},"parent_tool_use_id":null,"session_id":"7eab3fee-d238-414d-9526-fa8a20a5ba0e","uuid":"de23f7e8-bd86-4b4e-bd29-b3c93ad83223","timestamp":"2026-10-11T09:47:58.406Z"}
